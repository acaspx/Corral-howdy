# Rust
/target/
# Node / frontend
node_modules/
apps/desktop/dist/
*.tsbuildinfo
# Tauri generated
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/
# Swift / Xcode
native/CorralNative/.build/
native/CorralNative/.swiftpm/
*.xcuserstate
DerivedData/
# Eval reports (baselines are committed)
evals/reports/*
!evals/reports/baselines/
# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
# Never commit secrets
.env
.env.*
*.pem

# Agent skills from paid courses are licensed to the buyer: keep them local, never commit.
# (Emil Kowalski's AI for UI course installs as .claude/skills/emil-*; his public MIT skills,
# vendored in .claude/skills/, are committed. emil-design-eng is one of the public ones.)
.claude/skills/emil-*/
!.claude/skills/emil-design-eng/
# Other agents' local config and skill folders (any layout, e.g. .gemini/antigravity/skills/).
.cursor/
.gemini/
.agents/
.codex/
