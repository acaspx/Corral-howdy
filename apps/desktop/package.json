{
  "name": "@corral/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && pnpm run lint:glaze",
    "lint:glaze": "eslint -c glaze.eslint.config.mjs .",
    "test": "vitest run",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/postcss": "4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "storybook": "10.6.9",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
